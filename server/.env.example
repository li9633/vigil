# Vigil 服务端环境变量示例，复制为 .env 或直接导出到进程环境。
# 所有值均有开发默认值，生产环境必须修改。

# 数据库（SQLite 文件路径）
VIGIL_DATABASE_URL=sqlite+pysqlite:///./vigil.db

# 客户端注册用一次性引导令牌
VIGIL_BOOTSTRAP_TOKEN=vigil-bootstrap-dev

# 管理端账号（密码不再来自环境变量）
VIGIL_ADMIN_USERNAME=admin
# 首次启动生成随机初始密码并写入同目录 initial_admin_password（0600）；
# 登录后请在 Web 修改，忘记密码使用 vigil-admin reset-password。
# 管理员密码哈希所用的随机密钥文件（首次启动自动生成，权限 0600）
VIGIL_ADMIN_KEY_FILE=/var/lib/vigil/admin.key

# 会话 Cookie 签名密钥
VIGIL_SESSION_SECRET=vigil-dev-session-secret-change-me

# 心跳与状态机阈值（秒）
VIGIL_HEARTBEAT_INTERVAL=30
VIGIL_SUSPECT_SECONDS=90
VIGIL_DOWN_SECONDS=150
VIGIL_BEACON_SECONDS=180

# 鉴权时间窗与 nonce 保留时长（秒）
VIGIL_AUTH_WINDOW_SECONDS=300
VIGIL_NONCE_TTL_SECONDS=900

# worker 扫描间隔（秒）
VIGIL_WORKER_INTERVAL=10

# 是否允许客户端执行 L1 动作，以及动作冷却与每小时上限
VIGIL_ACTIONS_ENABLED=true
VIGIL_ACTION_COOLDOWN_SECONDS=300
VIGIL_ACTION_MAX_PER_HOUR=3

# 抖动（flapping）统计窗口与次数阈值
VIGIL_FLAPPING_WINDOW_SECONDS=1800
VIGIL_FLAPPING_THRESHOLD=3

# 明细数据保留天数
VIGIL_RETENTION_DAYS=30

# 数据盘水位告警（使用率百分比 / 冷却秒数 / 检查间隔秒数）
VIGIL_DISK_ALERT_PERCENT=85
VIGIL_DISK_ALERT_COOLDOWN_SECONDS=21600
VIGIL_DISK_CHECK_INTERVAL_SECONDS=300
