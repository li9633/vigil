#!/bin/sh /etc/rc.common
# Vigil agent 的 procd 服务脚本。
#
# 安装位置：/etc/init.d/vigil
# 依赖：python3-light、python3-urllib、python3-openssl（HTTPS 必需）
# 代码安装位置：/usr/lib/vigil/vigil_agent
#
# 单向监督链：procd 负责拉起与 respawn，agent 内部看门狗超时后 os._exit(1)。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
CONFIG=/etc/vigil/config.json
CODE_DIR=/usr/lib/vigil

start_service() {
    [ -x "$PROG" ] || {
        logger -t vigil "未找到 $PROG，请安装 python3-light"
        return 1
    }

    procd_open_instance "vigil-agent"
    procd_set_param command "$PROG" -m vigil_agent.main --config "$CONFIG"
    procd_set_param env PYTHONPATH="$CODE_DIR"
    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONFIG"
    procd_set_param limits nofile="1024 1024"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t vigil "vigil-agent 已启动"
}

stop_service() {
    logger -t vigil "vigil-agent 正在停止"
}

service_triggers() {
    procd_add_reload_trigger "vigil"
    # WAN/LAN 配置变更（/etc/init.d/network reload）后重启 agent 重新解析设备
    procd_add_reload_trigger "network"
}

reload_service() {
    stop
    start
}
